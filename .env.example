# Create this key in Resend and add the same values to Vercel.
RESEND_API_KEY=re_replace_me
CONTACT_TO_EMAIL=hello@vanto.studio

# Requires vanto.studio to be a verified sending domain in Resend (SPF + DKIM).
# Until that is done, onboarding@resend.dev works but only delivers to the
# address that owns the Resend account.
CONTACT_FROM_EMAIL="Vanto <hello@vanto.studio>"
